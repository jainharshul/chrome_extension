{
  "manifest_version": 3,
  "name": "Hello MV3",
  "version": "1.0.0",
  "description": "A tiny MV3 example that edits the current page.",
  "action": {
    "default_title": "Hello MV3",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
